    {
      "@type": "FAQPage",
      "@id": "https://www.alanranger.com/photo-editing-course-coventry#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What do I need to bring, and what software do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bring your own laptop with Adobe Lightroom Classic installed and an active subscription. Please install it and sign in before the first session. Alan provides a training Lightroom library of images to work from, so you can follow every tool hands-on — you don’t need to bring your own photos to start."
          }
        },
        {
          "@type": "Question",
          "name": "I’ve never edited before — will I keep up?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The course assumes no prior editing experience and starts from the very beginning — importing and organising before we touch any develop tools. With a maximum of three people there’s time for questions and individual help on your own screen."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to shoot in RAW?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No — the workflow applies to both RAW and JPG files. That said, RAW is where editing makes the biggest difference, and the course covers exactly why, so you’ll get the most from it if you start shooting RAW afterwards."
          }
        },
        {
          "@type": "Question",
          "name": "Lightroom Classic or the cloud version — which do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "This course teaches Lightroom Classic (the desktop, catalogue-based version), which is what most enthusiasts and professionals use. If you only have the cloud-based Lightroom, get in touch before booking and Alan will advise."
          }
        },
        {
          "@type": "Question",
          "name": "Why only three people per class?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Editing is best taught looking over your shoulder at your own screen. A maximum of three keeps it genuinely hands-on, so when you hit a problem Alan can see exactly what’s happening and help there and then."
          }
        },
        {
          "@type": "Question",
          "name": "Is there parking at the venue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — there’s space for two to three cars on the premises, plus free roadside parking on the cul-de-sac."
          }
        },
        {
          "@type": "Question",
          "name": "What if I miss one of the three weeks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The course runs as a fixed three-week block, so a missed session can’t be repeated within it. You’ll still receive the full course notes for that week, and if you’d like to cover it properly you can book a one-to-one private lesson with Alan to go through what you missed."
          }
        },
        {
          "@type": "Question",
          "name": "Is the venue accessible?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The classroom is on the ground floor with step-free access. Please note the toilet is on the first floor, up a flight of stairs. If you have any specific access needs, get in touch before booking and Alan will do his best to help."
          }
        },
        {
          "@type": "Question",
          "name": "Can under-18s attend?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — younger photographers are welcome, but anyone under 18 must be accompanied by a paying adult on the course."
          }
        },
        {
          "@type": "Question",
          "name": "What can I do after the course?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most people pair editing with the beginners camera course to strengthen their shooting, or continue with monthly mentoring or 1-2-1 lessons. If you’re aiming higher, there’s also RPS distinction support."
          }
        }
      ]
    },
