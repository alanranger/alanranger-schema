    {
      "@type": "FAQPage",
      "@id": "https://www.alanranger.com/photography-gift-vouchers#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What can the photography gift voucher be used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It can be redeemed against photography courses, workshops and private 1-to-1 lessons. It is not valid against print sales."
          }
        },
        {
          "@type": "Question",
          "name": "How is the voucher delivered?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is delivered digitally by email as an eCard or PDF. There is nothing physical to post, so it can be sent at short notice."
          }
        },
        {
          "@type": "Question",
          "name": "Can I send the voucher to the recipient on a later date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. At checkout choose the \"Email to you\" delivery option, then forward the email or PDF to the recipient whenever you like."
          }
        },
        {
          "@type": "Question",
          "name": "How does the recipient redeem their voucher?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They simply enter the unique code from the voucher at checkout when booking eligible items through the shopping cart."
          }
        },
        {
          "@type": "Question",
          "name": "Can an order be split between a voucher and a card payment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. If the order total is more than the voucher value, the remaining balance can be paid by card at checkout."
          }
        },
        {
          "@type": "Question",
          "name": "Do vouchers have an expiry date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Gift cards and eVouchers expire 12 months (1 year) from the date they are purchased."
          }
        },
        {
          "@type": "Question",
          "name": "Why do the vouchers have an expiry date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Expiry dates are needed because of accounting regulations governing how unspent gift vouchers are accounted for. Without one, an unspent voucher would remain a liability on the balance sheet indefinitely, which is not sustainable for a small business."
          }
        }
      ]
    },
