          }
        },
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Nicholas Barber"
          },
          "reviewBody": "I had a 1h 1:1 online mentoring session with Alan to sort out how to deal with my images on a long holiday. He was brilliant, clear instructions and a 2 page accurate summary of our conversation followed the same day.",
          "reviewRating": {
            "@type": "Rating",
