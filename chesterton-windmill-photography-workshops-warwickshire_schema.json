        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": "Angela Abraham"
          },
          "reviewBody": "Wonderful Photographer and Trainer. I have attended several courses and enjoyed everyone. Had a really great time. Excellent class.",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          },
          "datePublished": "2019-04-11",
