      "@type": "FAQPage",
      "@id": "https://www.alanranger.com/hire-a-professional-photographer-in-coventry#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which service do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you're selling products, choose commercial; for property listings or hospitality, choose property; for people and team images, choose headshots & portraits; to upskill your own staff, choose corporate training. A free 20-minute call can confirm the right route."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work in Coventry only?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coventry is the base, with regular work across Warwickshire and the West Midlands, and wider UK by arrangement for suitable projects."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to hire a photographer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Commercial and property shoots start from £150 (1 hour); headshots from £150 (individual) or £275 (team); corporate training from £175. Full pricing is on each service page."
          }
        },
        {
          "@type": "Question",
          "name": "Can you shoot on-site at our premises?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — commercial, property, headshots and training are all delivered on-site or on location as needed, planned around your brief."
          }
        },
        {
          "@type": "Question",
          "name": "How far do you travel and do travel costs apply?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Travel is typically included within 15 miles of CV4; beyond that it's £1/mile, invoiced separately. Exact terms are shown on each service page."
          }
        },
        {
          "@type": "Question",
          "name": "Can you help me plan before the shoot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — every service starts with a free 20-minute consultation to clarify the brief, usage and the right option before booking."
          }
        },
        {
          "@type": "Question",
          "name": "Do you photograph individuals as well as businesses?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — alongside business and commercial work, personal headshots, couples and graduation portraits are available on the headshots & portraits page."
          }
        },
        {
          "@type": "Question",
          "name": "How do I book?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Go straight to the relevant service page to view rates and book, or book a free 20-minute consultation and I'll point you to the right option."
          }
        }
      ]
